# OpsFlow Environment Configuration

# Database Connection (SQLite by default for zero-setup local execution)
# To use PostgreSQL, set: DATABASE_URL="postgresql://user:password@localhost:5432/opsflow?schema=public"
DATABASE_URL="file:./dev.db"

# Session / Auth Secret
NEXTAUTH_SECRET="opsflow-super-secret-development-key-32-chars-min"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
